# ========== 应用配置 ==========
APP_NAME=AI Agent
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production

# ========== 数据库 ==========
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
# DATABASE_URL=postgresql+asyncpg://agent:agent123@localhost:5432/ai_agent

# ========== LLM Provider ==========
# 可选: anthropic | openai | ollama | dashscope
# 内网部署推荐 ollama（见下方 Ollama 配置）
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# 云端 Provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
LLM_MODEL=qwen-plus

# ========== Embedding ==========
# ollama | openai | dashscope；留空则随 LLM_PROVIDER 自动推断
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ========== Agent 配置 ==========
MAX_AGENT_ITERATIONS=10
MAX_EXECUTION_TIME=120
TEMPERATURE=0.7
MAX_TOKENS=4096

# ========== RAG 配置 ==========
CHUNK_SIZE=800
CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3

# ========== 限流 & 安全 ==========
RATE_LIMIT_PER_MINUTE=30
MAX_TOKENS_PER_CONVERSATION=100000
CORS_ORIGINS=*

# ========== LangSmith (可选) ==========
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-agent

# ========== 存储 ==========
UPLOAD_DIR=./data/documents
LOG_DIR=./data/logs
